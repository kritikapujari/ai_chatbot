# ─────────────────────────────────────────────────────────────────────────────
# AI Chatbot + Agentic AI + GitHub MCP — Environment Configuration
#
# Copy this file to ".env" and fill in your actual values.
# NEVER commit the real .env file — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Ollama (local models) ─────────────────────────────────────────────────────
# Base URL of your local Ollama server. Change only if running on a different
# host or port.
OLLAMA_BASE_URL=http://localhost:11434

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── OpenRouter ────────────────────────────────────────────────────────────────
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Default model used by OpenRouter. See full list: https://openrouter.ai/models
# Example: anthropic/claude-3.5-sonnet
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ── GitHub Agent Mode (MCP) ───────────────────────────────────────────────────
# Personal Access Token with repo access for Agent Mode.
#
# Create at: https://github.com/settings/tokens/new
#
# Minimum required scopes:
#   READ operations:   repo (read access to private repos), public_repo
#   WRITE operations:  repo (full control), issues:write, pull-requests:write
#
# Recommended: use a fine-grained PAT scoped to specific repositories.
# The environment variable name matches the official GitHub MCP Server standard.
GITHUB_PERSONAL_ACCESS_TOKEN=
