# ─────────────────────────────────────────────────────────────────────────────
# AI Chatbot + Agentic AI + GitHub MCP — Environment Configuration
#
# Copy this file to ".env" and fill in your actual values.
# NEVER commit the real .env file — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Ollama (local models) ─────────────────────────────────────────────────────
# Base URL of your local Ollama server.
OLLAMA_BASE_URL=http://localhost:11434

# ── Website scraping options ─────────────────────────────────────────────────

# Maximum characters of scraped website data forwarded to the final Ollama call.
MAX_SCRAPED_CONTENT_CHARS=8000

# Context window (tokens) of the chosen Ollama model.
SCRAPER_MODEL_TOKENS=8192

# Local Ollama embedding model used by ScrapeGraphAI.
SCRAPER_EMBEDDING_MODEL=ollama/nomic-embed-text

# Set to "true" for verbose ScrapeGraphAI debug logging.
SCRAPER_VERBOSE=false

# Set to "false" to watch the Playwright browser while scraping.
SCRAPER_HEADLESS=true

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── OpenRouter ────────────────────────────────────────────────────────────────
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Default model used by OpenRouter.
# Example: anthropic/claude-3.5-sonnet
OPENROUTER_MODEL=